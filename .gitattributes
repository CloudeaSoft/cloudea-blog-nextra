# Normalize text files; commit with LF (Windows + Linux CI)
* text=auto eol=lf

# Explicit text types
*.css   text eol=lf
*.html  text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.jsonc text eol=lf
*.jsx   text eol=lf
*.md    text eol=lf
*.mdx   text eol=lf
*.mjs   text eol=lf
*.mts   text eol=lf
*.scss  text eol=lf
*.svg   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Shell / scripts
*.sh    text eol=lf
*.ps1   text eol=lf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary assets
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.mp4   binary
*.webm  binary

# Lockfile: keep LF, avoid noisy diffs from autocrlf
pnpm-lock.yaml text eol=lf linguist-generated=true
