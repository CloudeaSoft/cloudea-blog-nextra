{
	"compilerOptions": {
		"target": "es2025",
		"lib": [
			"dom",
			"esnext"
		],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"incremental": true,
		"module": "esnext",
		"esModuleInterop": true,
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"noUncheckedSideEffectImports": true,
		"libReplacement": false,
		"rootDir": ".",
		"types": [
			"node"
		],
		"plugins": [
			{
				"name": "next"
			}
		],
		"paths": {
			"@/*": [
				"./*"
			]
		}
	},
	"include": [
		"next-env.d.ts",
		".next/types/**/*.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/dev/types/**/*.ts"
	],
	"exclude": [
		"node_modules",
		"e2e",
		"playwright.config.ts",
		"playwright-report",
		"test-results"
	]
}
