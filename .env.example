NEXT_PUBLIC_BASE_URL = "http://localhost:3000"
# Read via utils/env.ts. Site root: leave unset, empty, or "/". Subpath: "/blog"
# Cloudflare Build Variables cannot set an empty value — omit this var or set "/".
NEXT_PUBLIC_BASE_PATH = ""
# Next.js output mode (utils/env.ts → getNextOutput). Default when unset: export.
#   export  → static export for GitHub Pages
#   server  → no output.export (SSR / Cloudflare Workers + API routes)
# Cloudflare cannot set empty env; use "server" instead of clearing this.
# Leave unset for local static builds, or set explicitly:
# NEXT_OUTPUT = "export"
# NEXT_OUTPUT = "server"
