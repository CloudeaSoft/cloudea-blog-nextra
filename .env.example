# Optional for build (navbar uses relative getHomeHref). Useful for absolute links.
NEXT_PUBLIC_BASE_URL = "http://localhost:3000"
# Read via utils/env.ts. Site root: leave unset, empty, or "/". Subpath: "/blog"
# Cloudflare Build Variables cannot set an empty value — omit this var or set "/".
NEXT_PUBLIC_BASE_PATH = ""
# Next.js output mode (utils/env.ts → getNextOutput). Default when unset: export.
#   export  → static export for GitHub Pages
#   server  → no output.export (SSR / Cloudflare Workers + API routes)
# Cloudflare cannot set empty env; use "server" instead of clearing this.
# Leave unset for local static builds, or set explicitly:
# NEXT_OUTPUT = "export"
# NEXT_OUTPUT = "server"

# Arknights proxy Worker origin (utils/env.ts → getBlogBackendUrl).
# Unset → production: https://blog-backend.cloudeasoft.workers.dev
# Local Worker: pnpm worker:dev → http://127.0.0.1:8787
# Debug deploy: https://blog-backend-dev.<account>.workers.dev
# NEXT_PUBLIC_BLOG_BACKEND_URL = "http://127.0.0.1:8787"
